# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Your Telegram user ID. The bot is private to you; share it later with /household.
# Leave empty on first run: the bot replies with your ID.
OWNER_USER_ID=

# Google Cloud
GCP_PROJECT=your-gcp-project-id
BQ_DATASET=finance
BQ_LOCATION=US
# Service-account key (roles: BigQuery Data Editor + BigQuery Job User)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Per-user fact tables are named <prefix><telegram_user_id>
FACT_TABLE_PREFIX=fct_expenses_
# Re-read dim_categories / dim_spend_variants every N seconds (or use /reload)
CATALOG_REFRESH_SECONDS=600

# Which AI reads your messages: gemini | claude | openai (ChatGPT)
LLM_PROVIDER=gemini

# Claude (only if LLM_PROVIDER=claude) — key from platform.claude.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Voice notes for Claude/ChatGPT (Gemini hears audio itself):
# local = Whisper on your Mac (free) | openai = OpenAI transcription API (paid)
TRANSCRIBER=local
# tiny | base | small | medium | large-v3  (small is a good balance for Russian)
WHISPER_MODEL=small

# ChatGPT (only if LLM_PROVIDER=openai) — key from platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Gemini (only if LLM_PROVIDER=gemini): set an API key from aistudio.google.com,
# OR leave empty to use Vertex AI with the service account
GEMINI_API_KEY=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash-lite

TIMEZONE=Asia/Almaty
DEFAULT_CURRENCY=KZT
# Telegram's "/" command list and ☰ button: off (default) or on
COMMAND_MENU=off
