# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Your Telegram user ID: the bot's owner (no limits, 👥 Users, /block). Anyone else can
# use the bot within the daily limits below. Leave empty on first run: the bot replies with your ID.
OWNER_USER_ID=

# Daily limits per person (not for you); reset at midnight in TIMEZONE. 0 = no limit.
DAILY_TEXT_LIMIT=50
DAILY_VOICE_LIMIT=30
MAX_VOICE_SECONDS=120

# Google Cloud
GCP_PROJECT=your-gcp-project-id
BQ_DATASET=finance
BQ_LOCATION=US
# Service-account key (roles: BigQuery Data Editor + BigQuery Job User)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Per-user fact tables are named <prefix><telegram_user_id>
FACT_TABLE_PREFIX=fct_expenses_
# Re-read dim_categories / dim_spend_variants every N seconds (or use /reload)
CATALOG_REFRESH_SECONDS=600

# Which AI reads your messages: gemini | claude | openai (ChatGPT)
LLM_PROVIDER=gemini

# Claude (only if LLM_PROVIDER=claude) — key from platform.claude.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Voice notes for Claude/ChatGPT (Gemini hears audio itself):
# local = Whisper on your Mac (free) | openai = OpenAI transcription API (paid)
TRANSCRIBER=local
# tiny | base | small | medium | large-v3  (small is a good balance for Russian)
WHISPER_MODEL=small

# ChatGPT (only if LLM_PROVIDER=openai) — key from platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Gemini (only if LLM_PROVIDER=gemini): set an API key from aistudio.google.com,
# OR leave empty to use Vertex AI with the service account
GEMINI_API_KEY=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash-lite

TIMEZONE=Asia/Almaty
DEFAULT_CURRENCY=KZT
# Telegram's "/" command list and ☰ button: off (default) or on
COMMAND_MENU=off

# Save an unanswered proposal with its suggested category after N minutes (0 = never)
AUTO_SAVE_MINUTES=10

# iPhone Action Button / Shortcut uploads (see README). Empty = off.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_SECRET=
INGEST_PORT=8787
# Public address of the endpoint, e.g. https://your-mac.tail1234.ts.net — turns on the
# 📲 Action Button menu item, which gives every user their own key and setup steps
INGEST_PUBLIC_URL=
# Optional iCloud link to a shareable copy of the Shortcut that asks for the key on install
SHORTCUT_URL=
SHORTCUT_NAME=Log expense

# 📊 Monitoring dashboard (owner only; sign in from the bot): on | off
# Mac only: http://127.0.0.1:<DASHBOARD_PORT>/dashboard, a port the Tailscale tunnel doesn't forward
DASHBOARD=on
DASHBOARD_PORT=8788

# "Delete my data": hidden at once, kept this many days (restorable in the bot), then erased. 0 = erase at once
DELETE_RETENTION_DAYS=30
